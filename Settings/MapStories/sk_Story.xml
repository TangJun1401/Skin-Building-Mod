	<Story Name="Story_ThanDien12" Parent="BaseFillingStory">
		<DisplayName>Chọn giới tính</DisplayName>
		<Desc>Vui lòng chọn giới tính của nhân vật.</Desc>
		<Kind>None</Kind>
		<Selections>
			<li>
				<Display>Nữ</Display>
				<Condition><![CDATA[
				me:GetSex() == 2
				]]>
				</Condition>
				<OKResult><![CDATA[
					me:TriggerStory("Story_Female_modelChange1");
				]]>	
				</OKResult>
				<NOResult>me:AddMsg(XT("[NAME] Chẳng làm gì cả, đã rời đi."));</NOResult>
			</li>
